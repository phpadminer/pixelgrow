# Database
DATABASE_URL="mysql://root:password@localhost:3306/pixelgrow"
PIXELGROW_DB_PASSWORD="change-this-docker-db-password"
PIXELGROW_DB_ROOT_PASSWORD="change-this-docker-root-password"

# Family Plan H5
# local default: demo, production default: starter
# demo: creates sample children, courses, habits, tasks, milestones, rules and gifts
# starter: creates children, rules and gifts only
# off: never creates initial data automatically
FAMILY_PLAN_SEED_MODE="starter"
FAMILY_PLAN_TOKEN_SECRET="change-this-in-production"
JWT_SECRET="change-this-in-production"

# Redis
REDIS_URL="redis://localhost:6379"

# WeChat Mini Program
WX_APP_ID="your_app_id"
WX_APP_SECRET="your_app_secret"
WX_MINIPROGRAM_STATE="trial"
FAMILY_PLAN_DAILY_REMINDER_TEMPLATE_ID="wduIlN0B6smtDm7dkeImwjdI2ahC8P4LvTLpco1jYZQ"
FAMILY_PLAN_DEADLINE_REMINDER_TEMPLATE_ID="wduIlN0B6smtDm7dkeImwjdI2ahC8P4LvTLpco1jYZQ"
FAMILY_PLAN_REMINDER_CRON_TOKEN="change-this-reminder-cron-token"
# Default reminder template fields:
# 日程名称 {{thing12.DATA}}, 提醒时间 {{time11.DATA}}, 提醒事项 {{thing3.DATA}}, 备注 {{thing9.DATA}}

# AI Services
DASHSCOPE_API_KEY="your_tongyi_api_key"
KLING_API_KEY="your_kling_api_key"

# Map
TENCENT_MAP_KEY="your_tencent_map_key"

# OSS
OSS_ACCESS_KEY="your_oss_key"
OSS_ACCESS_SECRET="your_oss_secret"
OSS_BUCKET="pixelgrow"
OSS_REGION="oss-cn-hangzhou"
