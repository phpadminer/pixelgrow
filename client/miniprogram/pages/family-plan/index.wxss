  position: relative;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
  color: currentColor;
  border: 3rpx solid currentColor;
  border-radius: 11rpx;
}

.nav-icon::before,
.nav-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.nav-icon.today {
  border-radius: 50%;
}

.nav-icon.today::after {
  left: 8rpx;
  top: 7rpx;
  width: 13rpx;
  height: 8rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.nav-icon.calendar::before {
  left: 5rpx;
  right: 5rpx;
  top: 9rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 8rpx 0 currentColor;
  opacity: 0.55;
}

.nav-icon.stats {
  border: 0;
  border-radius: 0;
}

.nav-icon.stats::before {
  left: 5rpx;
  bottom: 2rpx;
  width: 5rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: currentColor;
  box-shadow: 10rpx -8rpx 0 currentColor, 20rpx -14rpx 0 currentColor;
}

.nav-icon.exchange::before {
  left: 3rpx;
  right: 3rpx;
  top: 10rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 currentColor;
}

.nav-icon.exchange::after {
  left: 14rpx;
  top: -3rpx;
  width: 3rpx;
  height: 34rpx;
  background: currentColor;
  box-shadow: -8rpx 4rpx 0 -1rpx currentColor, 8rpx 4rpx 0 -1rpx currentColor;
}

.nav-icon.rules {
  border-radius: 14rpx 14rpx 18rpx 18rpx;
}

.nav-icon.rules::after {
  left: 10rpx;
  top: 8rpx;
  width: 10rpx;
  height: 7rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.nav-icon.profile {
  border: 0;
}

.nav-icon.profile::before {
  left: 10rpx;
  top: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.nav-icon.profile::after {
  left: 5rpx;
  top: 22rpx;
  width: 24rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(28, 32, 29, 0.5);
}

.start-choice-mask {
  align-items: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.sheet {
  width: 100%;
  max-width: 820rpx;
  max-height: 88vh;
  box-sizing: border-box;
  padding: 34rpx 34rpx calc(86rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  overflow-y: auto;
  background: #fffdfa;
  box-shadow: 0 -28rpx 70rpx rgba(57, 48, 31, 0.18);
}

.start-choice-sheet {
  max-width: 720rpx;
  padding: 42rpx 34rpx calc(52rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx;
  background: #fffdfa;
  box-shadow: 0 28rpx 80rpx rgba(57, 48, 31, 0.2);
}

.start-choice-head {
  margin-bottom: 30rpx;
}

.start-choice-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.start-choice-button {
  width: 100%;
  min-height: 132rpx;
  flex-direction: column;
  align-items: flex-start;
  padding: 22rpx 28rpx;
  text-align: left;
  box-sizing: border-box;
}

.choice-title {
  width: 100%;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
}

.choice-desc {
  width: 100%;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
  opacity: 0.78;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.sheet-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.wechat-login-box {
  margin-top: 10rpx;
}

.account-profile-box {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 22rpx;
  align-items: center;
  margin: 24rpx 0 28rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(245, 163, 22, 0.18);
  border-radius: 20rpx;
  background: #fffaf0;
}

.account-avatar-button {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff4cf;
  color: #d98900;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 112rpx;
}

.account-avatar-button::after {
  border: 0;
}

.account-avatar-image,
.account-avatar-placeholder {
  width: 112rpx;
  height: 112rpx;
}

.account-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.account-profile-fields {
  min-width: 0;
}

.compact-label {
  margin-top: 0;
}

.account-nickname-input {
  min-height: 72rpx;
  font-size: 26rpx;
}

.account-role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  color: #6f7f84;
  font-size: 24rpx;
  font-weight: 800;
}

.account-role-pill {
  min-width: 88rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(245, 163, 22, 0.14);
  color: #c57d00;
  text-align: center;
  font-weight: 900;
}

.family-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.family-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid rgba(84, 111, 106, 0.14);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
}

.family-row.active {
  border-color: rgba(245, 163, 22, 0.48);
  background: rgba(255, 244, 207, 0.82);
}

.family-row-title {
  margin-bottom: 8rpx;
  color: #101820;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.family-row-status {
  flex: 0 0 auto;
  color: #d8870c;
  font-size: 24rpx;
  font-weight: 900;
}

.family-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.family-actions.inline {
  min-width: 320rpx;
  margin-top: 0;
}

.family-empty-card {
  align-items: stretch;
}

.family-setup-card {
  align-items: center;
}

.family-setup-main {
  flex: 1 1 auto;
  min-width: 0;
}

.family-setup-card .agenda-title {
  margin: 8rpx 0;
  font-size: 42rpx;
  line-height: 1.18;
}

.invite-box {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(245, 163, 22, 0.44);
  background: rgba(255, 248, 232, 0.82);
}

.invite-code {
  color: #101820;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.empty-card.compact {
  margin: 0;
  padding: 26rpx;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.form-section {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(84, 111, 106, 0.14);
  background: rgba(248, 253, 250, 0.75);
}

.course-session-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 2rpx solid #ffe0a6;
  border-radius: 20rpx;
  background: rgba(255, 248, 232, 0.82);
}

.course-session-title {
  margin-bottom: 6rpx;
  color: #101820;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.course-session-badge {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ca;
  color: #d8870c;
  font-size: 22rpx;
  font-weight: 900;
}

.readonly-box {
  justify-content: flex-start;
  color: #536263;
  background: rgba(248, 253, 250, 0.78);
}

.course-session-type-row {
  margin: 12rpx 0 6rpx;
}

.course-session-save {
  margin-top: 28rpx;
}

.makeup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 18rpx 0 12rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid rgba(84, 111, 106, 0.08);
}

.image-picker {
  padding: 22rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(245, 163, 22, 0.26);
  background: rgba(255, 248, 232, 0.9);
}

.gift-image-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}

.image-action {
  margin-top: 16rpx;
}

.form-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.profile-save-button {
  margin-top: 36rpx;
}

.switch-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 26rpx 0;
  color: #405057;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.4;
}

.sheet-actions,
.gift-sheet > .primary-button:last-child {
  margin-top: 44rpx;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 18rpx;
}

.sheet-actions .primary-button {
  min-width: 0;
}

.sheet-actions .primary-button:only-child {
  grid-column: 1 / -1;
}

.timer-layer {
  position: fixed;
  inset: 0;
  z-index: 30;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 28%, rgba(255, 216, 97, 0.28), transparent 28%),
    linear-gradient(180deg, #fff2c3 0%, #f6a916 100%);
}

.timer-bg {
  position: absolute;
  top: 80rpx;
  right: -60rpx;
  width: 460rpx;
  height: 460rpx;
  opacity: 0.15;
}

.timer-close {
  position: absolute;
  right: 38rpx;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  color: #263238;
  font-size: 48rpx;
}

.timer-content {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 120rpx 44rpx 230rpx;
  color: #fff;
  text-align: center;
}

.timer-circle {
  width: 448rpx;
  height: 448rpx;
  border-radius: 50%;
  margin: 44rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 30rpx 58rpx rgba(145, 86, 7, 0.2);
}

.timer-circle.breathing {
  animation: timerBreath 1.8s ease-in-out infinite;
}

.timer-circle-inner {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ffd989 0%, #f7bd52 100%);
  box-shadow: inset 0 0 54rpx rgba(126, 75, 8, 0.08);
}

.timer-display {
  font-size: 78rpx;
  line-height: 1;
  font-weight: 900;
}

.timer-meta {
  max-width: 300rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  font-weight: 800;
  opacity: 0.86;
}

.timer-title {
  font-size: 44rpx;
  font-weight: 900;
}

.timer-actions {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 160rpx;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 46rpx rgba(145, 86, 7, 0.16);
}

.timer-actions .primary-button {
  background: #f5a316;
  box-shadow: none;
}

.timer-actions .secondary-dark {
  color: #9b731d;
  border-color: rgba(155, 115, 29, 0.24);
  background: #fffaf0;
  box-shadow: none;
}

.secondary-dark {
  min-height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(85, 71, 36, 0.18);
}

@keyframes timerBreath {
  0% {
    box-shadow: 0 30rpx 58rpx rgba(145, 86, 7, 0.2), 0 0 0 0 rgba(255, 248, 233, 0.18);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 34rpx 68rpx rgba(145, 86, 7, 0.24), 0 0 0 18rpx rgba(255, 248, 233, 0.16);
    transform: scale(1.015);
  }
  100% {
    box-shadow: 0 30rpx 58rpx rgba(145, 86, 7, 0.2), 0 0 0 0 rgba(255, 248, 233, 0.18);
    transform: scale(1);
  }
}

@media (min-width: 900px) {
  .family-page {
    box-shadow: 0 0 0 1rpx rgba(84, 111, 106, 0.08), 0 40rpx 90rpx rgba(111, 127, 132, 0.18);
  }
}
