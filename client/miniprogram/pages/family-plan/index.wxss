page {
  background: #fff8e7;
  color: #101820;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border: 0;
  background: transparent;
  font-family: inherit;
}

button::after {
  border: 0;
}

picker {
  display: block;
}

.family-page {
  position: relative;
  width: 100%;
  max-width: 860rpx;
  min-height: 100vh;
  margin: 0 auto;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 212, 81, 0.22), transparent 19%),
    radial-gradient(circle at 92% 4%, rgba(255, 192, 50, 0.18), transparent 17%),
    radial-gradient(circle at 82% 76%, rgba(255, 225, 142, 0.22), transparent 24%),
    linear-gradient(180deg, #fff8e7 0%, #fffdf5 34%, #fff7e3 100%);
}

.page-bg {
  position: fixed;
  top: 0;
  left: 50%;
  z-index: 0;
  width: 860rpx;
  height: 100vh;
  transform: translateX(-50%);
  pointer-events: none;
  overflow: hidden;
}

.bg-foot {
  position: absolute;
  opacity: 0.15;
}

.bg-chicken-foot {
  top: 110rpx;
  left: 56rpx;
  width: 148rpx;
  height: 148rpx;
}

.bg-sheep-hoof {
  top: 260rpx;
  left: 360rpx;
  width: 154rpx;
  height: 154rpx;
}

.bg-avatar {
  position: absolute;
  opacity: 0.1;
}

.bg-monkey {
  top: -62rpx;
  right: 140rpx;
  width: 284rpx;
  height: 284rpx;
}

.bg-dragon {
  top: -68rpx;
  right: -84rpx;
  width: 308rpx;
  height: 308rpx;
}

.bg-child {
  top: -52rpx;
  right: -36rpx;
  width: 306rpx;
  height: 306rpx;
  opacity: 0.08;
}

.bg-pattern {
  position: absolute;
  top: 170rpx;
  left: 26rpx;
  width: 220rpx;
  height: 180rpx;
  opacity: 0.18;
}

.app-shell,
.login-card,
.login-hero,
.bottom-nav,
.modal-mask,
.timer-layer {
  position: relative;
  z-index: 1;
}

.login-hero {
  padding: 92rpx 48rpx 34rpx;
  text-align: center;
}

.hero-family {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 22rpx;
}

.hero-avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  filter: drop-shadow(0 18rpx 20rpx rgba(184, 129, 34, 0.18));
}

.hero-side {
  width: 98rpx;
  height: 98rpx;
  opacity: 0.82;
}

.hero-title {
  font-size: 72rpx;
  line-height: 1.05;
  font-weight: 900;
  color: #f2aa13;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #a57930;
}

.login-card,
.summary-card,
.guest-expiry-card,
.guest-onboarding-card,
.focus-card,
.calendar-card,
.exchange-config,
.rule-card,
.profile-card,
.gift-card,
.countdown-card,
.empty-card,
.sheet {
  border: 2rpx solid rgba(151, 130, 82, 0.2);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 42rpx rgba(166, 123, 43, 0.08);
}

.login-card {
  margin: 48rpx 36rpx 56rpx;
  padding: 42rpx 34rpx 40rpx;
}

.login-card .role-switch {
  margin: 42rpx 0 38rpx;
}

.login-card .field-label {
  margin-top: 34rpx;
}

.login-card .text-input {
  min-height: 88rpx;
}

.login-card .primary-button {
  margin-top: 34rpx;
}

.login-card .helper-text {
  margin-top: 30rpx;
}

.eyebrow {
  font-size: 25rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #f4a016;
}

.eyebrow.light {
  color: rgba(255, 255, 255, 0.84);
}

.page-title {
  margin-top: 8rpx;
  font-size: 50rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 0;
  color: #101820;
}

.role-switch {
  display: flex;
  gap: 8rpx;
  margin: 34rpx 0;
  padding: 8rpx;
  border-radius: 22rpx;
  background: rgba(245, 220, 152, 0.33);
}

.role-switch.inner {
  margin: 18rpx 0 26rpx;
}

.role-option {
  flex: 1;
  min-height: 70rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #7a6847;
}

.role-option.active {
  color: #fff;
  background: linear-gradient(135deg, #ffd455, #f5a316);
  box-shadow: 0 14rpx 26rpx rgba(232, 146, 18, 0.24);
}

.field-label {
  margin: 26rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #405057;
}

.field-hint {
  margin: -4rpx 0 14rpx;
  color: #7b8785;
  font-size: 22rpx;
  line-height: 1.45;
}

.text-input,
.textarea-input,
.picker-box {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(84, 111, 106, 0.2);
  border-radius: 18rpx;
  padding: 0 26rpx;
  background: rgba(255, 255, 255, 0.88);
  font-size: 30rpx;
  font-weight: 800;
  color: #101820;
}

.textarea-input {
  height: 168rpx;
  padding-top: 22rpx;
  line-height: 1.5;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-grid {
  display: grid;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.weekday-chip-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.habit-type-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.grade-chip-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.choice-chip {
  min-height: 70rpx;
  border: 2rpx solid rgba(84, 111, 106, 0.18);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.86);
  color: #405057;
  font-size: 26rpx;
  font-weight: 900;
}

.choice-chip.active {
  border-color: rgba(245, 163, 22, 0.74);
  background: #fff1ca;
  color: #d8870c;
  box-shadow: 0 10rpx 22rpx rgba(232, 146, 18, 0.12);
}

.schedule-list {
  display: grid;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.schedule-row {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 14rpx;
  align-items: center;
}

.schedule-label {
  min-height: 70rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff1ca;
  color: #d8870c;
  font-size: 26rpx;
  font-weight: 900;
}

.schedule-time {
  min-height: 70rpx;
}

.schedule-controls {
  display: grid;
  gap: 10rpx;
}

.lesson-type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.lesson-type-chip {
  min-width: 92rpx;
  min-height: 54rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(84, 111, 106, 0.16);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  color: #536263;
  font-size: 22rpx;
  font-weight: 900;
}

.lesson-type-chip.active {
  border-color: rgba(245, 163, 22, 0.7);
  background: #fff1ca;
  color: #d8870c;
}

.lesson-type-chip.large {
  flex: 1;
  min-height: 68rpx;
  font-size: 26rpx;
}

.inline-field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.small-outline-button {
  min-width: 128rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid rgba(245, 163, 22, 0.55);
  border-radius: 16rpx;
  background: #fff8e8;
  color: #d8870c;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 900;
}

.extra-session-section {
  margin: 18rpx 0 24rpx;
}

.extra-session-empty {
  min-height: 64rpx;
  border: 2rpx dashed rgba(84, 111, 106, 0.18);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b8785;
  font-size: 24rpx;
  font-weight: 800;
}

.extra-session-row {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr) 104rpx;
  gap: 12rpx;
  align-items: start;
  margin-bottom: 12rpx;
}

.extra-session-row .picker-box {
  min-height: 70rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.extra-lesson-type-row {
  grid-column: 1 / 3;
}

.text-remove-button {
  min-height: 70rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(239, 107, 90, 0.28);
  border-radius: 16rpx;
  background: #fff5f2;
  color: #ef6b5a;
  font-size: 24rpx;
  line-height: 70rpx;
  font-weight: 900;
}

.lifecycle-section {
  margin-top: 20rpx;
}

.form-section-title {
  color: #d8870c;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 900;
}

.primary-button {
  min-height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ffd455, #f5a316);
  box-shadow: 0 16rpx 28rpx rgba(226, 137, 18, 0.2);
}

.primary-button.compact {
  min-height: 74rpx;
  min-width: 188rpx;
  font-size: 28rpx;
}

.primary-button.small,
.secondary-button {
  min-height: 64rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.primary-button.mini,
.secondary-button.mini {
  min-height: 56rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  color: #d98900;
  font-weight: 900;
  border: 2rpx solid rgba(245, 163, 22, 0.32);
  background: rgba(255, 244, 207, 0.9);
}

.secondary-button.full {
  width: 100%;
  margin-top: 18rpx;
}

.danger-button {
  min-height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  color: #c35d12;
  font-size: 28rpx;
  font-weight: 900;
  border: 2rpx solid rgba(195, 93, 18, 0.22);
  background: rgba(255, 241, 230, 0.94);
}

.ghost-button {
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(84, 111, 106, 0.18);
  background: rgba(255, 255, 255, 0.78);
  color: #263238;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.helper-text,
.muted {
  color: #6f7f84;
  font-size: 24rpx;
  line-height: 1.42;
}

.helper-text {
  margin-top: 22rpx;
}

.strong {
  font-weight: 900;
}

.app-shell {
  padding: 42rpx 34rpx 240rpx;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 34rpx;
  overflow: visible;
}

.family-status {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 420rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(245, 163, 22, 0.22);
  border-radius: 16rpx;
  background: rgba(255, 244, 207, 0.82);
  color: #8a5c00;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.family-status-action {
  color: #d8870c;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-right: 8rpx;
  overflow: visible;
}

.header-icon-button,
.role-button {
  position: relative;
  min-height: 70rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(84, 111, 106, 0.16);
  background: rgba(255, 255, 255, 0.76);
  color: #1f2a2e;
}

.header-icon-button {
  width: 68rpx;
  min-height: 68rpx;
  border-radius: 18rpx;
  overflow: visible;
}

.header-icon-button.active {
  color: #d8870c;
  background: #fff4dc;
}

.role-button {
  gap: 12rpx;
  min-height: 68rpx;
  padding: 0 24rpx 0 20rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.bell-shape {
  position: relative;
  width: 26rpx;
  height: 27rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  transform: translateY(-2rpx);
}

.bell-shape::before,
.bell-shape::after,
.login-shape::before,
.login-shape::after,
.logout-shape::before,
.logout-shape::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.bell-shape::before {
  left: -3rpx;
  right: -3rpx;
  bottom: -5rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.bell-shape::after {
  left: 9rpx;
  bottom: -12rpx;
  width: 8rpx;
  height: 5rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: currentColor;
}

.notification-badge {
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 5rpx;
  border: 3rpx solid #fff8e7;
  border-radius: 999rpx;
  background: #ef6b5a;
  color: #fff;
  font-size: 18rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.login-shape {
  position: relative;
  flex: 0 0 auto;
  width: 26rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-left: 0;
  border-radius: 0 5rpx 5rpx 0;
  transform: translateX(1rpx);
}

.login-shape::before {
  right: 11rpx;
  top: 10rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.login-shape::after {
  left: -5rpx;
  top: 6rpx;
  width: 11rpx;
  height: 11rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.logout-shape {
  position: relative;
  flex: 0 0 auto;
  width: 26rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-right: 0;
  border-radius: 5rpx 0 0 5rpx;
  transform: translateX(-1rpx);
}

.logout-shape::before {
  left: 11rpx;
  top: 10rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.logout-shape::after {
  right: -5rpx;
  top: 6rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.children-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.child-card {
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(84, 111, 106, 0.16);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}

.child-card.active {
  border-color: #f5a316;
  background: rgba(255, 244, 207, 0.92);
}

.child-avatar {
  flex: 0 0 auto;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #fff7d7;
}

.child-name {
  font-size: 29rpx;
  line-height: 1.2;
  font-weight: 900;
}

.summary-card {
  position: relative;
  display: flex;
  gap: 30rpx;
  align-items: center;
  overflow: hidden;
  margin-bottom: 34rpx;
  padding: 34rpx;
}

.summary-pattern {
  position: absolute;
  right: -20rpx;
  top: -54rpx;
  width: 230rpx;
  height: 230rpx;
  opacity: 0.08;
}

.rate-ring {
  flex: 0 0 auto;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3ead2;
}

.ring-inner {
  width: 106rpx;
  height: 106rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.summary-main {
  position: relative;
  z-index: 1;
}

.summary-percent {
  margin: 6rpx 0;
  font-size: 52rpx;
  line-height: 1.05;
  font-weight: 900;
}

.point-pill {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff0c8;
  color: #d98900;
  font-size: 25rpx;
  font-weight: 900;
}

.tab-content {
  margin-top: 30rpx;
  padding-bottom: 132rpx;
}

.focus-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 30rpx;
}

.guest-expiry-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 30rpx 28rpx 30rpx;
  margin-bottom: 24rpx;
  border-color: rgba(245, 163, 22, 0.28);
  background: rgba(255, 247, 222, 0.92);
}

.guest-expiry-main {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 22rpx;
}

.guest-save-button {
  flex: 0 0 168rpx;
  min-width: 168rpx;
  padding: 0 18rpx;
  white-space: nowrap;
}

.guest-expiry-close {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  min-height: 42rpx;
  padding: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  color: #8a6a28;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 900;
}

.guest-onboarding-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-color: rgba(245, 163, 22, 0.24);
  background: linear-gradient(180deg, rgba(255, 250, 240, 0.96), rgba(255, 255, 255, 0.9));
}

.onboarding-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin: 24rpx 0;
}

.onboarding-step {
  min-height: 86rpx;
  padding: 14rpx 10rpx;
  border: 2rpx solid rgba(84, 111, 106, 0.14);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #6f7f84;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.onboarding-step.active {
  border-color: rgba(245, 163, 22, 0.34);
  background: #fff4cf;
  color: #c57d00;
}

.step-index {
  width: 32rpx;
  height: 32rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  background: rgba(245, 163, 22, 0.16);
  line-height: 32rpx;
  font-size: 20rpx;
}

.focus-time {
  margin-top: 8rpx;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 900;
}

.focus-edit-row {
  display: flex;
  gap: 14rpx;
  margin: 18rpx 0 12rpx;
}

.focus-edit-field {
  min-width: 118rpx;
}

.mini-label {
  margin-bottom: 6rpx;
  color: #65767b;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 900;
}

.mini-input {
  width: 112rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 2rpx solid rgba(84, 111, 106, 0.18);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #101820;
  font-size: 26rpx;
  font-weight: 900;
}

.quick-actions {
